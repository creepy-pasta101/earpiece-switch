<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive-icon layer, 108dp canvas. The visible area is the central 72dp
    (safe circle of radius 36 around 54,54); the whole glyph sits inside it.
    Glyph: an in-ear speaker arc opening to the right, plus two sound waves.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Earpiece body: 270-degree arc, the 90-degree gap faces the sound waves. -->
    <path
        android:pathData="M58.849,68.849 A21,21 0 1 1 58.849,39.151"
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Inner sound wave. -->
    <path
        android:pathData="M72.191,43.739 A30,30 0 0 1 72.191,64.261"
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Outer sound wave. -->
    <path
        android:pathData="M82.527,39.977 A41,41 0 0 1 82.527,68.023"
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

</vector>
