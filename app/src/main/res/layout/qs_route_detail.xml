<?xml version="1.0" encoding="utf-8"?>
<!--
    Detail panel for the Quick Settings tile, hosted by Samsung One UI's SystemUI through the
    hidden semGetDetailView() hook on RouteTileService.

    Built from plain Android views only: the panel is inflated inside SystemUI's process from a
    RemoteViews, so Compose, data binding and custom views are all unavailable here. Label text and
    check marks are set from code (RouteTileService.semGetDetailView), never in this file.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/row_earpiece"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:background="?android:attr/selectableItemBackground">

        <TextView
            android:id="@+id/label_earpiece"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:text="" />

        <TextView
            android:id="@+id/check_earpiece"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:text="✓"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_speaker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:background="?android:attr/selectableItemBackground">

        <TextView
            android:id="@+id/label_speaker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:text="" />

        <TextView
            android:id="@+id/check_speaker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:text="✓"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_bluetooth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:background="?android:attr/selectableItemBackground">

        <TextView
            android:id="@+id/label_bluetooth"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:text="" />

        <TextView
            android:id="@+id/check_bluetooth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:text="✓"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_wired"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:background="?android:attr/selectableItemBackground">

        <TextView
            android:id="@+id/label_wired"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:text="" />

        <TextView
            android:id="@+id/check_wired"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:text="✓"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
